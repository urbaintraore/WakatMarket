rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is a participant in a conversation
    function isParticipant(conversationId) {
      return isAuthenticated() && 
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    // 1. User Profiles Rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // 2. Connections Rules
    // IDs are formatted as senderId_receiverId (sorted alphabetically)
    match /connections/{connectionId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId
      );
      
      // Anyone can create a connection request as long as they are the sender and status is "en_attente"
      allow create: if isAuthenticated() && 
        request.auth.uid == request.resource.data.senderId && 
        request.resource.data.status == 'en_attente';
        
      // Only the receiver can update the connection status (validate/refuse)
      allow update: if isAuthenticated() && 
        request.auth.uid == resource.data.receiverId && 
        (request.resource.data.status == 'active' || request.resource.data.status == 'refusée') &&
        request.resource.data.senderId == resource.data.senderId; // Prevent altering sender
        
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId
      );
    }

    // 3. Notifications Rules
    match /notifications/{notificationId} {
      // Users can only read and update their own notifications
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId && request.resource.data.userId == resource.data.userId;
      
      // Users can create notifications for other users (e.g. for connection requests)
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.senderId;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // 4. Conversations Rules
    match /conversations/{conversationId} {
      // A user must be in the participants array to read or write
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      
      // Ensure users can only create/update conversations they are a part of
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow delete: if false; // Conversations should not be deleted casually

      // Nested Messages Rules
      match /messages/{messageId} {
        // Must be a participant in the parent conversation to read or write messages
        allow read: if isParticipant(conversationId);
        allow create: if isParticipant(conversationId) && request.auth.uid == request.resource.data.senderId;
        allow update: if isParticipant(conversationId) && (
          // Only sender can edit content, or anyone in the group can update readBy/status
          request.auth.uid == resource.data.senderId || 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'status', 'transcription'])
        );
        allow delete: if isParticipant(conversationId) && request.auth.uid == resource.data.senderId;
      }
    }
  }
}
