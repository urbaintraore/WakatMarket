{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and credentials information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "nom": { "type": "string" },
        "prénom": { "type": "string" },
        "email": { "type": "string" },
        "téléphone": { "type": "string" },
        "rôle": { "type": "string" },
        "statut": { "type": "string" },
        "pays": { "type": "string" },
        "ville": { "type": "string" },
        "quartier": { "type": "string" },
        "companyName": { "type": "string" }
      },
      "required": ["uid", "nom", "email", "rôle"]
    },
    "Vente": {
      "title": "Vente",
      "description": "Represents a direct B2B or B2C sale transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "vendeurId": { "type": "string" },
        "vendeurNom": { "type": "string" },
        "acheteurId": { "type": "string" },
        "acheteurNom": { "type": "string" },
        "total": { "type": "number" },
        "statut": { "type": "string" },
        "statutPaiement": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "vendeurId", "total", "statut"]
    },
    "StockItem": {
      "title": "StockItem",
      "description": "Inventory stock record per owner and product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "produitId": { "type": "string" },
        "quantite": { "type": "number" },
        "seuilAlerte": { "type": "number" },
        "prixUnitaire": { "type": "number" },
        "expirationDate": { "type": "string" }
      },
      "required": ["id", "produitId", "quantite"]
    },
    "Relation": {
      "title": "Relation",
      "description": "B2B Partnership relation between two users",
      "type": "object",
      "properties": {
        "demandeurId": { "type": "string" },
        "destinataireId": { "type": "string" },
        "participants": { "type": "string" },
        "statut": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["demandeurId", "destinataireId", "statut"]
    },
    "Connection": {
      "title": "Connection",
      "description": "Represents a connection request or active relationship between two business actors",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "alphabetic sorted combination of senderId and receiverId" },
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "status": { "type": "string", "enum": ["en_attente", "active", "refusée"] },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string" },
        "receiverName": { "type": "string" },
        "receiverRole": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "senderId", "receiverId", "status", "senderName", "senderRole", "receiverName", "receiverRole", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Represents an in-app user notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "description": "The recipient's user ID" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "message"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and credentials"
    },
    "/ventes/{venteId}": {
      "schema": "Vente",
      "description": "Direct sales records"
    },
    "/stocks/{ownerId}/items/{itemId}": {
      "schema": "StockItem",
      "description": "Stock items owned by merchants and visible to active partners"
    },
    "/relations/{relationId}": {
      "schema": "Relation",
      "description": "B2B partnership and connections"
    },
    "/connections/{connectionId}": {
      "schema": "Connection",
      "description": "B2B Actor connection requests and relationships"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    },
    "/notifications/{uid}/items/{notifId}": {
      "schema": "Notification",
      "description": "Per-user subcollection notifications"
    }
  }
}
