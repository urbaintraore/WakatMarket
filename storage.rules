rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Preuves de paiement par capture d'écran
    match /preuves-paiement/{venteId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 15 * 1024 * 1024;
    }
    
    // Factures générées
    match /factures/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Fichiers généraux
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
