rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 0. FONCTIONS ET HELPERS GLOBAUX (Partagés CampusBF & WakatMarket)
    // =========================================================================

    // Helper: Vérifie si l'utilisateur est connecté
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Vérifie si l'utilisateur possède un email d'administrateur principal
    function isSpecialAdminEmail() {
      return isAuthenticated() && (
        request.auth.token.email == "urbain.traore@yahoo.fr" || 
        request.auth.token.email == "urbain.traoreurb@gmail.com"
      );
    }

    // Helper: Vérifie si l'utilisateur est un administrateur système
    function isAdmin() {
      return isAuthenticated() && (
        isSpecialAdminEmail() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data['rôle'] == "ADMIN")
      );
    }

    // Helper: Vérifie si une relation B2B active existe entre l'utilisateur connecté et un tiers
    function estPartenaireActif(autreUid) {
      return (exists(/databases/$(database)/documents/relations/$(request.auth.uid + "_" + autreUid)) && 
              (get(/databases/$(database)/documents/relations/$(request.auth.uid + "_" + autreUid)).data.statut == 'actif' || get(/databases/$(database)/documents/relations/$(request.auth.uid + "_" + autreUid)).data.statut == 'active'))
          || (exists(/databases/$(database)/documents/relations/$(autreUid + "_" + request.auth.uid)) && 
              (get(/databases/$(database)/documents/relations/$(autreUid + "_" + request.auth.uid)).data.statut == 'actif' || get(/databases/$(database)/documents/relations/$(autreUid + "_" + request.auth.uid)).data.statut == 'active'))
          || (exists(/databases/$(database)/documents/connections/$(request.auth.uid + "_" + autreUid)) && 
              (get(/databases/$(database)/documents/connections/$(request.auth.uid + "_" + autreUid)).data.status == 'active' || get(/databases/$(database)/documents/connections/$(request.auth.uid + "_" + autreUid)).data.status == 'actif'))
          || (exists(/databases/$(database)/documents/connections/$(autreUid + "_" + request.auth.uid)) && 
              (get(/databases/$(database)/documents/connections/$(autreUid + "_" + request.auth.uid)).data.status == 'active' || get(/databases/$(database)/documents/connections/$(autreUid + "_" + request.auth.uid)).data.status == 'actif'));
    }

    // =========================================================================
    // SECTION 1 : UTILISATEURS & AUTHENTIFICATION (Partagé CampusBF & WakatMarket)
    // =========================================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && (!('rôle' in request.resource.data) || request.resource.data['rôle'] == resource.data['rôle'])) || 
        isAdmin()
      );
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    match /utilisateurs/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && (!('rôle' in request.resource.data) || request.resource.data['rôle'] == resource.data['rôle'])) || 
        isAdmin()
      );
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // =========================================================================
    // SECTION 2 : WAKATMARKET (Commerce B2B/B2C, Stocks, Ventes, Facturation)
    // =========================================================================

    // 2.1 Ventes et Commandes directes
    match /ventes/{venteId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.vendeurId == request.auth.uid || 
        resource.data.acheteurId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.vendeurId == request.auth.uid ||
        request.resource.data.acheteurId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource == null || 
        resource.data.vendeurId == request.auth.uid || 
        resource.data.acheteurId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAuthenticated() && isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource == null || 
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAuthenticated() && isAdmin();
    }

    match /factures/{factureId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.vendeurId == request.auth.uid || 
        resource.data.acheteurId == request.auth.uid || 
        isAdmin()
      );
      allow create, update: if isAuthenticated();
    }

    // 2.2 Relations de Partenariat B2B (/relations/{relationId})
    match /relations/{relationId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid in resource.data.participants ||
        request.auth.uid == resource.data.demandeurId ||
        request.auth.uid == resource.data.destinataireId ||
        isAdmin()
      );

      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.demandeurId ||
        request.auth.uid in request.resource.data.participants ||
        isAdmin()
      );

      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.destinataireId) ||
        (request.auth.uid == resource.data.demandeurId) ||
        (request.auth.uid in resource.data.participants) ||
        isAdmin()
      );

      allow delete: if isAuthenticated() && (
        request.auth.uid in resource.data.participants ||
        request.auth.uid == resource.data.demandeurId ||
        request.auth.uid == resource.data.destinataireId ||
        isAdmin()
      );
    }

    // Rétrocompatibilité B2B: /connections/{connectionId}
    match /connections/{connectionId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.receiverId ||
        request.auth.uid == resource.data.senderId ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId ||
        isAdmin()
      );
    }

    // 2.3 Notifications par utilisateur (/notifications/{uid}/items/{notifId})
    match /notifications/{uid}/items/{notifId} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.expediteurId ||
        request.auth.uid == uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
    }

    // Rétrocompatibilité : Collection globale /notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.userId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource == null || 
        resource.data.userId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        resource == null || 
        resource.data.userId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
    }

    // 2.4 Stocks, Inventaires et Catalogue Produits
    match /stocks/{ownerId}/items/{itemId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == ownerId || 
        estPartenaireActif(ownerId) || 
        isAdmin()
      );
      allow write: if isAuthenticated() && (
        request.auth.uid == ownerId || 
        isAdmin()
      );
    }

    match /inventory/{inventoryId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.userId || 
        request.auth.uid == resource.data.ownerId ||
        isAdmin()
      );
    }

    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        resource == null ||
        resource.data.creatorId == request.auth.uid ||
        request.resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
    }

    // 2.5 Messagerie & Chat B2B
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        request.auth.uid in resource.data.participants || 
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.auth.uid in request.resource.data.participants ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource == null || 
        request.auth.uid in resource.data.participants || 
        isAdmin()
      );

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }
    }

    // 2.6 Comptabilité privée par utilisateur (/comptabilite/{uid}/**)
    match /comptabilite/{uid}/{document=**} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == uid || 
        isAdmin()
      );
    }

    // =========================================================================
    // SECTION 3 : CAMPUSBF (Préservation des collections étudiantes et académiques)
    // =========================================================================

    // Collections académiques et étudiantes spécifiques à CampusBF
    match /etudiants/{docId=**} {
      allow read, write: if isAuthenticated();
    }
    match /formations/{docId=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /cours/{docId=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /inscriptions/{docId=**} {
      allow read, write: if isAuthenticated();
    }
    match /logements/{docId=**} {
      allow read, write: if isAuthenticated();
    }
    match /offres/{docId=**} {
      allow read, write: if isAuthenticated();
    }
    match /universites/{docId=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /actualites/{docId=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
