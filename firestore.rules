rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Vérifie si l'utilisateur est authentifié
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Vérifie si l'utilisateur possède un email d'administrateur
    function isSpecialAdminEmail() {
      return isAuthenticated() && (
        request.auth.token.email == "urbain.traore@yahoo.fr" || 
        request.auth.token.email == "urbain.traoreurb@gmail.com"
      );
    }

    // Helper: Vérifie si l'utilisateur est un administrateur
    function isAdmin() {
      return isAuthenticated() && (
        isSpecialAdminEmail() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rôle == "ADMIN")
      );
    }

    // Helper: Vérifie si une relation de partenariat ACTIVE existe entre deux UIDs
    function estPartenaireActif(autreUid) {
      let relId1 = request.auth.uid + "_" + autreUid;
      let relId2 = autreUid + "_" + request.auth.uid;
      return (exists(/databases/$(database)/documents/relations/$(relId1)) && 
              (get(/databases/$(database)/documents/relations/$(relId1)).data.statut == 'actif' || get(/databases/$(database)/documents/relations/$(relId1)).data.statut == 'active'))
          || (exists(/databases/$(database)/documents/relations/$(relId2)) && 
              (get(/databases/$(database)/documents/relations/$(relId2)).data.statut == 'actif' || get(/databases/$(database)/documents/relations/$(relId2)).data.statut == 'active'))
          || (exists(/databases/$(database)/documents/connections/$(relId1)) && 
              (get(/databases/$(database)/documents/connections/$(relId1)).data.status == 'active' || get(/databases/$(database)/documents/connections/$(relId1)).data.status == 'actif'))
          || (exists(/databases/$(database)/documents/connections/$(relId2)) && 
              (get(/databases/$(database)/documents/connections/$(relId2)).data.status == 'active' || get(/databases/$(database)/documents/connections/$(relId2)).data.status == 'actif'));
    }

    // 1. Profils Utilisateurs
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && (!('rôle' in request.resource.data) || request.resource.data.rôle == resource.data.rôle)) || 
        isAdmin()
      );
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // 2. Collection /relations/{relationId} (Structure stricte demandée)
    match /relations/{relationId} {
      // Un utilisateur ne peut lire un document relation que s'il est participant
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid in resource.data.participants ||
        request.auth.uid == resource.data.demandeurId ||
        request.auth.uid == resource.data.destinataireId
      );

      // Création de demande de connexion ou enregistrement direct de partenaire
      allow create: if isAuthenticated() && 
        request.auth.uid == request.resource.data.demandeurId &&
        request.auth.uid in request.resource.data.participants &&
        (request.resource.data.statut == 'en_attente' || request.resource.data.statut == 'actif' || request.resource.data.statut == 'active');

      // Réponse par le destinataire, renvoi par le demandeur, ou admin
      allow update: if isAuthenticated() && (
        // Cas 1 : Le destinataire répond à la demande (accepter ou refuser)
        (request.auth.uid == resource.data.destinataireId &&
         (request.resource.data.statut == 'actif' || request.resource.data.statut == 'refuse') &&
         request.resource.data.demandeurId == resource.data.demandeurId) ||
         
        // Cas 2 : Le demandeur renvoie ou met à jour la demande
        (request.auth.uid == resource.data.demandeurId &&
         request.resource.data.statut == 'en_attente' &&
         request.resource.data.destinataireId == resource.data.destinataireId) ||
         
        // Cas 3 : Administrateur
        isAdmin()
      );

      // Suppression par l'un des deux participants
      allow delete: if isAuthenticated() && (
        request.auth.uid in resource.data.participants ||
        request.auth.uid == resource.data.demandeurId ||
        request.auth.uid == resource.data.destinataireId
      );
    }

    // 3. Sous-collection /notifications/{uid}/items/{notifId} (Sous-collection par utilisateur)
    match /notifications/{uid}/items/{notifId} {
      // Un utilisateur ne peut lire que ses propres notifications
      allow read: if isAuthenticated() && request.auth.uid == uid;

      // Un utilisateur peut marquer ses notifications comme lues
      allow update: if isAuthenticated() && request.auth.uid == uid;

      // Création de notification : soit par l'expéditeur lors d'une action, soit pour soi-même
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.expediteurId ||
        request.auth.uid == uid
      );

      // Suppression de ses propres notifications
      allow delete: if isAuthenticated() && request.auth.uid == uid;
    }

    // Rétrocompatibilité : Collection globale /notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow update: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }

    // Rétrocompatibilité : Collection /connections
    match /connections/{connectionId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.receiverId ||
        request.auth.uid == resource.data.senderId
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId
      );
    }

    // 4. Stocks / Inventaire conditionnés par la relation ACTIVE
    match /stocks/{ownerId}/items/{itemId} {
      allow read: if isAuthenticated() && (request.auth.uid == ownerId || estPartenaireActif(ownerId));
      allow write: if isAuthenticated() && request.auth.uid == ownerId;
    }

    match /inventory/{inventoryId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.userId || 
        request.auth.uid == resource.data.ownerId || 
        ('userId' in resource.data && estPartenaireActif(resource.data.userId)) ||
        ('ownerId' in resource.data && estPartenaireActif(resource.data.ownerId))
      );
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.userId || 
        request.auth.uid == resource.data.ownerId
      );
    }

    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // 5. Conversations / Messages Chat
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }
    }

    // 6. Comptabilité privée par utilisateur (/comptabilite/{uid}/**)
    match /comptabilite/{uid}/{document=**} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }
  }
}
